{
    "root": {
        "prototype": "mod/data/service/expression-data-mapping",
        "values": {
            "objectDescriptor": {"@": "DataObjectDescriptor"},
            "rawDataPrimaryKeys":["id"],
            "objectMapping": {
                "rules": {
                    "fullModuleId": {"<->": "fullModuleId"},
                    "originId": {"<->": "originId"},
                    "originDataSnapshot": {
                        "<->": "originDataSnapshot"
                    },
                    "description": {"<->": "description"},
                    "isTemplate": {"<->": "isTemplate"},
                    "type":{
                        "<->": "typeId",
                        "converter": {"@": "typeForeignKeyConverter"}
                    },
                    "subtypes": {
                        "<->": "id",
                        "converter": {"@": "subtypesConverter"}
                    },
                    "isType": {"<->": "isType"},
                    "typeInstances": {
                        "<->": "id",
                        "converter": {"@": "typeInstancesConverter"}
                    },
                    "templateName": {"<->": "templateName"},
                    "template":{
                        "<->": "templateId",
                        "converter": {"@": "templateForeignKeyConverter"}
                    },
                    "templateDescription": {"<->": "templateDescription"},
                    "templateInstances": {
                        "<->": "id",
                        "converter": {"@": "templateInstancesConverter"}
                    },
                    "existenceTimeRange": {
                        "<->": "existenceTimeRange",
                        "converter": {"@": "string-to-range-converter"}
                    },
                    "creationDate": {
                        "<->": "creationDate",
                        "converter": {"@": "string-to-date-converter"}
                    },
                    "creationIdentity": {
                        "<->": "creationIdentityId",
                        "converter": {"@": "creationIdentityConverter"}
                    },
                    "modificationDate": {
                        "<->": "modificationDate",
                        "converter": {"@": "string-to-date-converter"}
                    },
                    "modificationIdentity": {
                        "<->": "modificationIdentityId",
                        "converter": {"@": "modificationIdentityConverter"}
                    },
                    "publicationDate": {
                        "<->": "publicationDate",
                        "converter": {"@": "string-to-date-converter"}
                    },
                    "publicationIdentity": {
                        "<->": "publicationIdentityId",
                        "converter": {"@": "publicationIdentityConverter"}
                    },
                    "archivalDate": {
                        "<->": "archivalDate",
                        "converter": {"@": "string-to-date-converter"}
                    },
                    "archivalIdentity": {
                        "<->": "archivalIdentityId",
                        "converter": {"@": "archivalIdentityConverter"}
                    }

                }
            },
            "rawDataMapping": {
                "rules": {
                }
            },
            "requisitePropertyNames": [
                "creationDate","modificationDate"
            ]
        }
    },

    "DataObjectDescriptor": {
        "object": "mod/data/model/data-object.mjson"
    },
    "string-to-date-converter": {
        "prototype": "mod/core/converter/i-s-o-8601-formatted-string-to-date-converter"
    },
    "jsonbConverter": {
        "prototype": "postgre-s-q-l.mod/core/converter/postgresql-jsonb-converter"
    },
    "typeForeignKeyConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "id == $"
        }
    },
    "subtypesConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "typeId == $ && isType == true"
        }
    },
    "typeInstancesConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "typeId == $"
        }
    },
    "templateForeignKeyConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "id == $"
        }
    },
    "templateInstancesConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "templateId == $"
        }
    },
    "typeInstancesForeignKeyConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "typeId == $"
        }
    },
    "string-to-range-converter": {
        "prototype": "mod/core/converter/r-f-c-3339-u-t-c-range-string-to-date-range-converter"
    },
    "creationIdentityConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "id == $"
        }
    },
    "modificationIdentityConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "id == $"
        }
    },
    "publicationIdentityConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "id == $"
        }
    },
    "archivalIdentityConverter": {
        "prototype": "mod/data/converter/raw-foreign-value-to-object-converter",
        "values": {
            "convertExpression": "id == $"
        }
    }
}
